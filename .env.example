# ===== AI Interactive Growth Agent 环境变量 =====
# 复制为 .env 后填写；禁止把真实 Key 提交到 Git

# --- 后端 ---
APP_ENV=development
LOG_LEVEL=INFO
# 生产用 PostgreSQL（含 pgvector）：postgresql+psycopg2://user:pass@postgres:5432/growth
# 本地开发可用 SQLite：sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://growth:growth@postgres:5432/growth

# --- LLM（OpenAI 兼容；留空则自动使用 MockProvider，系统离线可跑）---
LLM_PROVIDER=mock              # mock | openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=0.5
LLM_EMBEDDING_MODEL=            # 留空则复用 LLM_MODEL

# --- 前端 BFF 指向后端 ---
BACKEND_URL=http://backend:8000   # 本地开发: http://localhost:8000
# --- 鉴权 / 管理员（生产 EXE 与 Docker 均建议 true） ---
AUTH_REQUIRED=true                 # true: 所有接口需 Bearer 登录；false: 开发离线放行
AUTH_SECRET=请改成随机长串            # JWT 签名密钥；留空会从主机名派生(不建议生产)
ADMIN_USERNAME=admin               # 逗号分隔的用户名列表，启动时自动提升为管理员

# --- 图片 / 视频（可选，mock 则离线）---
IMAGE_PROVIDER=mock                # mock | siliconflow
IMAGE_API_KEY=
VIDEO_PROVIDER=mock                # mock | seedance(火山方舟)
VIDEO_API_KEY=

# --- 订单/支付(manual)：先人工收款->后台确认->自动发点。接真支付时把 orders.provider 换成 wechat/alipay ---
# 本阶段无需配置；创建订单/核销走 /api/orders。

