# ===== CloudBase 云函数环境变量模板 =====
# 在 CloudBase「云函数→配置→环境变量」或「云托管」里设置，严禁提交到 Git。
# 已由 .gitignore 忽略 .env* ；此处模板仅供你复制参考。

# --- 数据库：CloudBase MySQL ---
# 在 CloudBase「云数据库 MySQL」里建库后，填入外部连接串，例如：
# DATABASE_URL=mysql+pymysql://<用户>:<密码>@<host>:<port>/<库名>?charset=utf8mb4
APP_ENV=cloud
DATABASE_URL=

# --- 鉴权 / 管理员 ---
AUTH_REQUIRED=true
AUTH_SECRET=请填随机长串
ADMIN_USERNAME=admin

# --- 混元 HUNYU LLM (OpenAI 兼容端点) ---
# LML_PROVIDER=siliconflow 为旧别名；用 openai_compat 接混元：
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1   # 以混元官方 OpenAI 兼容地址为准
LLM_API_KEY=你的混元key                                  # 或经腾讯云密钥管理注入
LLM_MODEL=hunyuan-turbos-250528
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=180

# 腾讯云 CAM Secret（混元若走签名，则按需填；OpenAI 兼容端点常只需要上面的 key）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# --- 视频/图片（本阶段建议 mock 省成本）---
VIDEO_PROVIDER=mock
IMAGE_PROVIDER=mock

# --- 兑换码/订单留空即可：表在 MySQL 里由 bootstrap_schema 建 ---
